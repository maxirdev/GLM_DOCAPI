{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--output-dir",
        ".playwright-mcp/output",
        "--user-data-dir",
        ".playwright-mcp/browser-profile",
        "--save-session"
      ],
      "enabled": true
    }
  }
}
