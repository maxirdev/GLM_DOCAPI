      <Part type="528d1c06-a9c2-420d-bd35-21dca83f12ff">
        <Source><![CDATA[
&colQueryParams = ObtenerParametrosQueryParams(&APIGLMRequestIn.QueryParams)
if &colQueryParams.Count > 0
    &EmpCod = &colQueryParams.Item(1).ToNumeric()
    &ProCod = &colQueryParams.Item(3).ToString()
    &ProductorAPI = new()
    &ProductorAPI.Codigo = &EmpCod
    &ProductorAPI.Nombre = 'Productor de prueba'
    if &ProductorAPI.Codigo > 0
        &APIGLMResponse = GenerarAPIGLMResponse(HttpCode.OK, '', &ProductorAPI.ToJson())
    else
        &APIGLMResponse = GenerarAPIGLMResponse(HttpCode.BadRequest, 'Servicio invocado sin los parametros necesarios', '')
    endif
else
    &APIGLMResponse = GenerarAPIGLMResponse(HttpCode.NotFound, 'No se encontro el productor', '')
endif
]]></Source>
